# Copy this file to .env.local and fill it in. .env.local is gitignored: never commit real values.
# All keys live in the Supabase dashboard under Project Settings -> API Keys.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...) from the "API Keys" tab. Low privilege, safe in the
# browser, always subject to Row Level Security. The legacy "anon" key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) from the "Secret keys" section. BYPASSES Row Level Security.
# Used only by src/lib/supabase/admin.ts on the server. The legacy "service_role" key also works.
# Never expose to the browser; on Vercel, add it as a server-side env var only.
SUPABASE_SECRET_KEY=

# Project ref (the subdomain of the Project URL). Only needed for `npm run db:types`.
SUPABASE_PROJECT_REF=
